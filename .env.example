# Variables de entorno del proyecto.
# No incluir contraseñas, tokens ni otros secretos.

# Puertos expuestos en el host
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000

# PostgreSQL
POSTGRES_DB=horarios
POSTGRES_USER=horarios_user
POSTGRES_PASSWORD=horarios_pass

# Cadenas de conexion para servicios internos de Docker Compose
DATABASE_URL=postgresql://horarios_user:horarios_pass@db:5432/horarios
REDIS_URL=redis://redis:6379/0

# Variable de build para el frontend
VITE_API_URL=http://localhost:8000